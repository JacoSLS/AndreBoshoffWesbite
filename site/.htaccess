# Freeland Well and Water Services
# ---------------------------------------------------------------------------
# Works as-is on Apache with cPanel (Afrihost, Namecheap, DreamHost and most
# other shared hosts). If your host runs nginx instead, see README.md — the
# same rules need to go into the server block.
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # =========================================================================
  # Send every visitor to https://www.freelandwellandwater.com
  #
  # These lines are ON. Until the padlock exists (cPanel > SSL/TLS Status >
  # Run AutoSSL) browsers show a security warning - that is normal for the
  # first minutes on a new domain. /.well-known/ is left alone so AutoSSL
  # can always check the domain. To switch the lines off, put "# " in front
  # of the RewriteCond / RewriteRule lines. Leave the ### lines alone.
  # =========================================================================

  ### 1 of 2 - force https
   RewriteCond %{REQUEST_URI} !^/\.well-known/
   RewriteCond %{HTTPS} !=on
   RewriteCond %{HTTP:X-Forwarded-Proto} !https
   RewriteRule ^(.*)$ https://www.freelandwellandwater.com/$1 [L,R=301]

  ### 2 of 2 - force www
   RewriteCond %{REQUEST_URI} !^/\.well-known/
   RewriteCond %{HTTP_HOST} !^www\. [NC]
   RewriteRule ^(.*)$ https://www.freelandwellandwater.com/$1 [L,R=301]

  # --- robots.txt is generated by robots.php so it always carries the right
  #     sitemap address. Do not add a static robots.txt file next to this
  #     one; it would win. ---
  RewriteRule ^robots\.txt$ /robots.php [L]

  # --- Never serve notes, settings or backups (README.md, .user.ini, *.zip ...).
  #     robots.txt still works because its rule above comes first. ---
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)[^/]*\.(md|txt|log|ini|bak|old|zip|sql|sh)$ - [F,NC]

  # Send /index and /index.php to / so the home page has one address
  RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Send /page.php to /page so only one address is ever indexed
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Send /page/ to /page (folders such as /admin/ keep their slash)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # --- Clean URLs: /services instead of /services.php ---
  # Only when that exact .php file exists, so made-up addresses get the 404 page
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# --- Keep the data folder private. It holds the login password hash. ---
<IfModule mod_authz_core.c>
  <FilesMatch "\.(json|log)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(json|log)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# --- Nothing in the uploads folder may run as a script: see assets/uploads/.htaccess ---

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://www.facebook.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.facebook.com; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

ErrorDocument 404 /404.php
